# =============================================================================
#  SmartphoneCafe backend - example configuration
# =============================================================================
#  Copy this file to `backend/.env` and fill in real values:
#
#      cp backend/.env.example backend/.env
#
#  `backend/.env` is git-ignored and must NEVER be committed. The values below
#  are placeholders only - no real credential appears in this file.
# =============================================================================

# --------------------------------------------------------------------- MySQL --
# Host and port of the MySQL server.
DB_HOST=127.0.0.1
DB_PORT=3306

# Database created by database/schema.sql.
DB_NAME=smartphonecafe

# Database user. Grant this account rights only on the application database,
# not on the whole server.
DB_USER=your_db_user

# Database password. Use a strong, unique value.
# If it contains # or ; wrap it in double quotes: DB_PASSWORD="p@ss#word"
DB_PASSWORD=your_db_password

# ------------------------------------------------------------------- Server --
# Port the Express API listens on.
PORT=4000

# ------------------------------------------------------------------- Uploads --
# Directory where uploaded images are written, relative to the backend folder
# unless an absolute path is given. MySQL stores only the resulting path.
UPLOAD_DIR=../uploads

# Maximum accepted upload size in megabytes.
MAX_UPLOAD_MB=5

# Reject images whose decoded dimensions exceed this many megapixels, as a guard
# against decompression bombs (a tiny file that expands to a huge bitmap).
MAX_UPLOAD_PIXELS=40

# ------------------------------------------------------------------- Frontend --
# Origin(s) allowed to call the API (CORS). Comma-separate to allow more than
# one. In development this is the Vite dev server. In PRODUCTION set it to the
# real HTTPS site origin, e.g. https://smartphonecafe.in
# When the built SPA is served by this same Express server (the intended
# deployment), requests are same-origin and this only needs the site origin.
FRONTEND_URL=http://localhost:5173

# Public canonical HTTPS origin, used to build absolute URLs in robots.txt and
# sitemap.xml. In PRODUCTION this MUST be the real site origin (no trailing
# slash), e.g. https://smartphonecafe.in
PUBLIC_SITE_URL=http://localhost:5173

# ---------------------------------------------------------------------- Auth --
# Secret used to sign admin session tokens.
# Generate a long random value, for example:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# How long an admin session stays valid, in hours.
SESSION_HOURS=12

# bcrypt cost factor for password hashing (10-15). Higher is slower and safer.
BCRYPT_ROUNDS=12

# --------------------------------------------------------------------- Runtime --
# Set to `production` on the live server. In production the session cookie is
# marked Secure (HTTPS-only), so the site MUST be served over HTTPS.
NODE_ENV=development

# =============================================================================
#  Notes
# =============================================================================
#  * Nothing in this file is a real credential.
#  * DB_PASSWORD and JWT_SECRET must be changed before deployment.
#  * In production set NODE_ENV=production, FRONTEND_URL and PUBLIC_SITE_URL to
#    the real https:// origin, and serve the site over HTTPS.
#  * The frontend must never receive any of these values. It talks only to the
#    API; the API talks to MySQL.
# =============================================================================
