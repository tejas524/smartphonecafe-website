# Dependencies
node_modules/
.vercel/

# Build output
dist/
dist-ssr/
*.local

# Vite dep-optimiser cache
.vite/

# Runtime CMS uploads. The directory must exist after a clone, but the files
# the admin panel writes into it are user data — never committed.
uploads/*
!uploads/.gitkeep

# Local npm cache (used when the global cache is unavailable)
.npm-cache/

# Environment / secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Scratch / extraction tooling (not part of the shipped site)
_tools/

# Generated image-processing reports
**/scripts/*.report.json
