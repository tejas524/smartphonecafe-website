# Normalise line endings so the repo does not churn on Windows/Unix checkouts.
* text=auto eol=lf

# Binary assets — never touched by text normalisation.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Keep SQL dumps diffable as text but with consistent endings.
*.sql text eol=lf

# Generated / vendored — collapse in diffs and language stats.
package-lock.json -diff linguist-generated=true
frontend/public/shop-images/** linguist-generated=true
frontend/src/data/photos.js linguist-generated=true
