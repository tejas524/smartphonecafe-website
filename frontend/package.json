{
  "name": "smartphonecafe-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SmartphoneCafe — public website (React + Vite) in Talegaon Dabhade, Maharashtra.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:preview": "vite build --mode preview",
    "preview:export": "node scripts/export-preview.mjs",
    "images:compress": "node scripts/compress-images.mjs",
    "preview": "vite preview",
    "assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-brand-assets.ps1",
    "photos": "node scripts/process-shop-photos.mjs",
    "catalog": "node scripts/process-catalog-images.mjs",
    "ocr": "powershell -NoProfile -ExecutionPolicy Bypass -File ../_tools/ocr-shop-photos.ps1"
  },
  "dependencies": {
    "embla-carousel-react": "^8.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.11",
    "vite": "^6.0.7"
  }
}
