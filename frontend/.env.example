# Public build settings only. Never put database passwords, JWT keys, or other
# secrets in VITE_* variables: they are included in browser JavaScript.
VITE_SITE_URL=https://smartphonecafe.in
# Enable only after switching on Web Analytics in the Vercel project dashboard.
# Leave false on Hostinger unless an equivalent analytics endpoint is configured.
VITE_ENABLE_ANALYTICS=false
